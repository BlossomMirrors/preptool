{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:path:default",
    "opener:default",
    "shell:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://cdn.blossomos.org/iso/**"
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "powershell",
          "cmd": "powershell",
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "powershell",
          "cmd": "powershell",
          "args": true
        }
      ]
    },
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$RESOURCE/**"
        },
        {
          "path": "$DOWNLOAD/**"
        }
      ]
    },
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-remove",
    "fs:allow-exists",
    "http:default",
    "log:allow-log",
    "log:default"
  ]
}