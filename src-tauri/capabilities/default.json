{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:default",
    "opener:default",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "powershell",
          "cmd": "powershell",
          "args": true
        }
      ]
    },
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$RESOURCE/**" }]
    },
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-exists"
  ]
}
