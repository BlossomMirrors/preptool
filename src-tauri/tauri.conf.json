{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "preptool",
  "version": "0.1.0",
  "identifier": "org.blossomos.preptool",
  "build": {
    "beforeDevCommand": "bun run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:web",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "preptool",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "windows": [
    {
      "title": "preptool",
      "width": 800,
      "height": 600
    }
  ],
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["scripts/*.ps1"],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerIcon": "icons/icon.ico",
        "artifactLanguage": "en-US"
      }
    }
  }
}
